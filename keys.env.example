# ===== Miku settings. Copy to keys.env (the setup script does this) and keep keys.env private. =====

# Which AI to use: grok, deepseek or claude
# Switching keeps all of Miku's memory. Just change this word and restart.
PROVIDER=grok

# Paste your API keys after the = sign (no spaces, no quotes).
# You only need the key for the PROVIDER you picked.
XAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# ===== Saving money =====
# How many recent messages are sent with each request (her short-term memory).
# Lower = cheaper. The full chat history is still saved on disk.
MAX_MEMORY_MESSAGES=30
